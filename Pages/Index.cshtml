@page
@model IndexModel
@{
    ViewData["Title"] = "Search Books";
}

<div class="py-4">
    <h1>Find your next book</h1>
    <p class="lead">Search by title or author to discover books for your reading list.</p>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info" role="status">@Model.StatusMessage</div>
    }

    <form method="get" class="row g-3 mb-5" role="search">
        <div class="col-md-9">
            <label asp-for="Query" class="form-label">Title or author</label>
            <input asp-for="Query" class="form-control" placeholder="Example: The Hobbit or Andy Weir" autofocus />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </form>

    @if (Model.HasSearched && Model.SearchResult is not null && !Model.SearchResult.IsSuccess)
    {
        <p class="alert alert-info" role="status">@Model.SearchResult.Message</p>
    }
    else if (Model.SearchResult is { IsSuccess: true } searchResult)
    {
        <h2 class="mb-4">Search results</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var book in searchResult.Books)
            {
                <div class="col">
                    <article class="card h-100 shadow-sm">
                        <div class="row g-0 h-100">
                            <div class="col-4">
                                <img src="@book.CoverUrl"
                                     class="img-fluid rounded-start h-100 object-fit-cover"
                                     alt="Cover of @book.Title" />
                            </div>
                            <div class="col-8">
                                <div class="card-body d-flex flex-column h-100">
                                    <h3 class="card-title h5">@book.Title</h3>
                                    <p class="card-text mb-2">@book.Author</p>
                                    <p class="card-text small text-muted mt-auto">ISBN: @book.Isbn13</p>
                                    @if (!string.IsNullOrWhiteSpace(book.Description))
                                    {
                                        <p class="card-text small">@book.Description</p>
                                    }
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form method="post" asp-page-handler="AddToList" class="mt-auto">
                                            <input type="hidden" name="Query" value="@Model.Query" />
                                            <input type="hidden" asp-for="AddToListInput.Title" value="@book.Title" />
                                            <input type="hidden" asp-for="AddToListInput.Author" value="@book.Author" />
                                            <input type="hidden" asp-for="AddToListInput.GoogleBooksId" value="@book.GoogleBooksId" />
                                            <input type="hidden" asp-for="AddToListInput.CoverUrl" value="@book.CoverUrl" />
                                            <button type="submit" class="btn btn-primary w-100">Add to List</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="btn btn-outline-primary w-100 mt-auto"
                                           asp-area="Identity"
                                           asp-page="/Account/Login">Sign in to add</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

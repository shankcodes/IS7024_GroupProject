@page
@model ReadingListModel
@using IS7024_GroupProject.Models

@{
    ViewData["Title"] = "My Reading List";
}

<h1 class="mb-4">My Reading List</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">
        @Model.StatusMessage
    </div>
}

<h2 class="mb-3">Books</h2>

@if (Model.Entries.Count == 0)
{
    <div class="alert alert-info">
        Your list is empty.
        <a asp-page="/Index">Search for a book</a>
        to get started.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var entry in Model.Entries)
        {
            <div class="col">
                <article class="card h-100 shadow-sm">
                    <div class="row g-0 h-100">

                        <!-- Book Cover -->
                        <div class="col-4">
                            @IndexModel.CreateCoverImage(
                                entry.Book.CoverUrl,
                                entry.Book.Title,
                                "img-fluid rounded-start book-cover")
                        </div>

                        <div class="col-8">
                            <div class="card-body">

                                <!-- Book Details -->
                                <h3 class="card-title h5">
                                    @entry.Book.Title
                                </h3>

                                <p class="card-text mb-1">
                                    @entry.Book.Author
                                </p>

                                <p class="card-text small text-muted">
                                    Status: @(entry.Status switch
                                    {
                                        ReadingStatus.WantToRead => "Want to Read",
                                        ReadingStatus.Reading => "Reading",
                                        ReadingStatus.Finished => "Finished",
                                        _ => entry.Status.ToString()
                                    })
                                </p>

                                <!-- Update Reading Status -->
                                <form method="post"
                                      asp-page-handler="UpdateStatus"
                                      class="mt-3">

                                    <input type="hidden"
                                           name="StatusInput.ReadingListId"
                                           value="@entry.ReadingListId" />

                                    <label for="status-@entry.ReadingListId"
                                           class="form-label">
                                        Reading status
                                    </label>

                                    <select name="StatusInput.Status"
                                            id="status-@entry.ReadingListId"
                                            class="form-select"
                                            aria-label="Reading status for @entry.Book.Title">

                                        <option value="WantToRead"
                                                selected="@(entry.Status == ReadingStatus.WantToRead)">
                                            Want to Read
                                        </option>

                                        <option value="Reading"
                                                selected="@(entry.Status == ReadingStatus.Reading)">
                                            Reading
                                        </option>

                                        <option value="Finished"
                                                selected="@(entry.Status == ReadingStatus.Finished)">
                                            Finished
                                        </option>

                                    </select>

                                    <span asp-validation-for="StatusInput.Status"
                                          class="text-danger"></span>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm mt-2">
                                        Save status
                                    </button>
                                </form>

                                <!-- Finished Date -->
                                @if (entry.FinishedDate is not null)
                                {
                                    <p class="card-text small text-muted mt-2">
                                        Finished:
                                        @entry.FinishedDate.Value.ToString("d")
                                    </p>
                                }

                                <!-- Remove Book -->
                                <form method="post"
                                      asp-page-handler="Remove"
                                      class="mt-2"
                                      onsubmit="return confirm('Remove this book from your list?');">

                                    <input type="hidden"
                                           name="RemoveInput.ReadingListId"
                                           value="@entry.ReadingListId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            aria-label="Remove @entry.Book.Title from your list">
                                        Remove
                                    </button>
                                </form>

                            </div>
                        </div>

                    </div>
                </article>
            </div>
        }

    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
    
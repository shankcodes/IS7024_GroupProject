@using IS7024_GroupProject.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
            <button type="submit" class="nav-link btn btn-link navbar-account-link">Log out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link navbar-account-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link navbar-account-link" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    </li>
}
</ul>